---
// App shell: a top bar and a floating dock at the foot of the screen, the same on
// phones and desktop. Both faces (genç / kurum) are rendered; html[data-mode]
// shows one, so the right nav is there before any script runs.
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { NAV, isActive, type Mode } from '../components/shell/nav';
import NavIcon from '../components/shell/NavIcon';
import ModeSwitch from '../components/shell/ModeSwitch';
import Account from '../components/shell/Account';
import { Mark } from '../components/ui/icons';
import { Overlays } from '../components/ui/kit';
import DemoTour from '../components/app/DemoTour';
import Assistant from '../components/assistant/Assistant';
import SahaDefteri from '../components/genc/SahaDefteri';
import NowBar from '../components/genc/NowBar';

interface Props {
  title: string;
  description?: string;
  /** genc / kurum pin the face; auto keeps whatever this tab last used. */
  mode?: Mode | 'auto';
  /** Content column width: narrow for the young side, wide for kurum work. */
  width?: 'narrow' | 'wide';
}

const {
  title,
  description = 'Yetkinliği beyana değil, doğrulanabilir işe bağlayan açık kaynak kurum–yetenek platformu.',
  mode = 'auto',
  width = 'narrow',
} = Astro.props;
const fullTitle = `${title} · nirengi`;
// The static Pages build renders /lig as lig.html.
const path = Astro.url.pathname.replace(/\.html$/, '');
const hasRail = Astro.slots.has('rail');
---

<!doctype html>
<html lang="tr" data-mode={mode === 'auto' ? 'genc' : mode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="tr_TR" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161521" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline define:vars={{ pinned: mode }}>
      (() => {
        const d = document.documentElement;
        let t;
        try { t = localStorage.getItem('nirengi:theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        // Keep the per-tab persona and the shown face in step before React mounts.
        const KEY = 'nirengi:view';
        let view = {};
        try { view = JSON.parse(sessionStorage.getItem(KEY) || localStorage.getItem(KEY) || '{}'); } catch {}
        if (pinned !== 'auto') {
          view.persona = pinned === 'kurum' ? 'org' : 'person';
          try {
            const raw = JSON.stringify({ blind: true, revealed: [], ...view });
            sessionStorage.setItem(KEY, raw);
            localStorage.setItem(KEY, raw);
          } catch {}
        }
        d.dataset.mode = view.persona === 'org' ? 'kurum' : 'genc';
      })();
    </script>
    <style is:global>
      html[data-mode='kurum'] .only-genc,
      html[data-mode='genc'] .only-kurum {
        display: none !important;
      }
    </style>
  </head>
  <body class="min-h-dvh">
    <a href="#icerik" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[90] focus:rounded-[12px] focus:bg-indigo focus:px-4 focus:py-2 focus:text-white">İçeriğe geç</a>

    <!-- top bar: wordmark, the Genç/Kurum switch on desktop, and the menu key -->
    <header class="vt-top sticky top-0 z-40 border-b-2 border-line bg-bg/95 backdrop-blur">
      <div class="mx-auto flex h-[60px] max-w-[1240px] items-center justify-between gap-4 px-4 sm:px-6 lg:h-[68px] lg:px-10">
        <a href="/" aria-label="nirengi ana sayfa" class="flex items-center gap-2">
          <Mark size={32} />
          <span class="text-[22px] font-black tracking-[-0.03em] text-indigo lg:text-[24px]">nirengi</span>
        </a>
        <div class="flex items-center gap-3">
          <div class="hidden w-[200px] lg:block"><ModeSwitch client:only="react" /></div>
          <details class="relative">
            <summary class="menu-key btn-ink btn-sm cursor-pointer list-none !min-h-10 !w-11 !px-0 [&::-webkit-details-marker]:hidden" aria-label="Menü">
              <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
                <path class="menu-a" d="M5 7h14" /><path class="menu-b" d="M5 12h9" /><path class="menu-c" d="M5 17h14" />
              </svg>
            </summary>
            <div class="menu-pop card absolute right-0 top-14 z-50 w-72 space-y-3 p-4 shadow-[0_12px_32px_-12px_rgb(0_0_0/0.25)]">
              <div class="lg:hidden"><ModeSwitch client:only="react" /></div>
              <Account client:only="react" />
              <a href="/yontem" class="block rounded-[12px] px-3 py-2 text-[15px] font-extrabold text-ink-2 hover:bg-bg-2">Skorlar nasıl hesaplanıyor?</a>
              <button type="button" data-theme-toggle class="block w-full rounded-[12px] px-3 py-2 text-left text-[15px] font-extrabold text-ink-2 hover:bg-bg-2">Tema değiştir</button>
              <button type="button" data-tour-open class="block w-full rounded-[12px] px-3 py-2 text-left text-[15px] font-extrabold text-ink-2 hover:bg-bg-2">Demo turu</button>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="icerik" class="vt-page">
      <div class:list={['mx-auto flex gap-12 px-4 pb-36 pt-6 sm:px-6 lg:px-10 lg:pt-10', width === 'wide' ? 'max-w-[1240px]' : 'max-w-[1080px]']}>
        <div class="flow min-w-0 flex-1"><slot /></div>
        {hasRail && <aside class="flow flow-rail hidden w-[340px] shrink-0 xl:block"><slot name="rail" /></aside>}
      </div>
    </main>

    <!--
      Dock: one floating bar at the foot of every screen. The plate under the active
      item is placed by --i / --n (equal slots), so it is right before any script runs;
      a tap glides it to the new item, then the page changes (script below).
    -->
    <nav class="vt-dock dock" aria-label="Sekmeler">
      {
        (['genc', 'kurum'] as const).map((m) => {
          const at = NAV[m].findIndex((item) => isActive(item, path));
          return (
            <div class={`only-${m} dock-row`} style={`--n:${NAV[m].length};--i:${Math.max(at, 0)}`} data-dock data-at={at}>
              <span class="dock-blob" data-off={at < 0 ? '' : undefined} aria-hidden="true">
                <svg viewBox="0 0 16 10" class="dock-pointer">
                  <path d="M2.5 2h11L8 8Z" fill="currentColor" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
                </svg>
              </span>
              <ul class="relative flex">
                {NAV[m].map((item, i) => (
                  <li class="min-w-0 flex-1 lg:w-[92px] lg:flex-none">
                    <a href={item.href} data-i={i} data-on={i === at ? '' : undefined} aria-current={i === at ? 'page' : undefined} class="dock-item">
                      <span class="dock-icon"><NavIcon icon={item.icon} size={28} /></span>
                      <span class="dock-label">{item.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </nav>

    <Overlays client:only="react" />
    <DemoTour client:only="react" />
    <Assistant client:only="react" />
    <SahaDefteri client:only="react" />
    <NowBar client:only="react" />

    <script>
      for (const b of document.querySelectorAll('[data-theme-toggle]'))
        b.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('nirengi:theme', next);
          } catch {}
        });
      // Cards that start below the fold rise in when they scroll into view. Islands mount late,
      // so new cards are picked up as they appear. Reduced motion: nothing is hidden.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const main = document.getElementById('icerik');
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              io.unobserve(el);
              el.classList.add('rv-in');
              el.addEventListener('transitionend', () => el.classList.remove('rv', 'rv-in'), { once: true });
            }
          },
          { rootMargin: '0px 0px -6% 0px' },
        );
        const scan = () => {
          for (const el of main?.querySelectorAll<HTMLElement>('.card:not([data-rv]), .card-press:not([data-rv])') ?? []) {
            el.dataset.rv = '';
            if (el.getBoundingClientRect().top < innerHeight || el.closest('[role="dialog"]')) continue;
            el.classList.add('rv');
            io.observe(el);
          }
        };
        if (main) new MutationObserver(scan).observe(main, { childList: true, subtree: true });
        scan();
      }
      // Dock: a tap glides the plate to the new item (the leading edge first, the
      // trailing edge catching up), the icon hops, and only then the page changes, so
      // the motion finishes before the next page takes over. Targets are prefetched.
      {
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        let pending = 0;
        const fetched = new Set<string>();
        const prefetch = (href: string) => {
          if (fetched.has(href)) return;
          fetched.add(href);
          const l = document.createElement('link');
          l.rel = 'prefetch';
          l.href = href;
          document.head.append(l);
        };
        const rows = document.querySelectorAll<HTMLElement>('[data-dock]');
        const reset = () => {
          clearTimeout(pending);
          for (const row of rows) {
            const at = Number(row.dataset.at);
            const blob = row.querySelector<HTMLElement>('.dock-blob')!;
            blob.classList.remove('to-l', 'to-r');
            blob.toggleAttribute('data-off', at < 0);
            row.style.setProperty('--i', String(Math.max(at, 0)));
            for (const a of row.querySelectorAll<HTMLElement>('.dock-item')) {
              a.classList.remove('going');
              a.toggleAttribute('data-on', Number(a.dataset.i) === at);
            }
          }
        };
        for (const row of rows) {
          const blob = row.querySelector<HTMLElement>('.dock-blob')!;
          row.addEventListener('pointerover', (e) => {
            const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.dock-item');
            if (a) prefetch(a.href);
          });
          row.addEventListener('click', (e) => {
            const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.dock-item');
            if (!a || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            if (a.pathname.replace(/\.html$/, '') === location.pathname.replace(/\.html$/, '')) {
              scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' });
              return;
            }
            const from = Number(row.style.getPropertyValue('--i'));
            const to = Number(a.dataset.i);
            for (const o of row.querySelectorAll('.dock-item')) o.toggleAttribute('data-on', o === a);
            a.classList.remove('going');
            void a.offsetWidth;
            a.classList.add('going');
            if (blob.hasAttribute('data-off')) {
              // Not on a dock page: the plate pops in at the target instead of travelling.
              blob.classList.remove('to-l', 'to-r');
              row.style.setProperty('--i', String(to));
              void blob.offsetWidth;
              blob.removeAttribute('data-off');
            } else {
              blob.classList.toggle('to-r', to > from);
              blob.classList.toggle('to-l', to < from);
              row.style.setProperty('--i', String(to));
            }
            clearTimeout(pending);
            pending = window.setTimeout(() => location.assign(a.href), still ? 0 : 320);
          });
        }
        // Back/forward restores this page from the cache with the plate where the tap left it.
        addEventListener('pageshow', (e) => e.persisted && reset());
        const idle = window.requestIdleCallback ?? ((f: () => void) => setTimeout(f, 1200));
        idle(() => {
          for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-dock] a.dock-item')) if (a.offsetWidth) prefetch(a.href);
        });
      }
      for (const b of document.querySelectorAll('[data-tour-open]'))
        b.addEventListener('click', (e) => {
          (e.currentTarget as HTMLElement).closest('details')?.removeAttribute('open');
          window.dispatchEvent(new Event('nirengi:tour'));
        });
    </script>
  </body>
</html>
