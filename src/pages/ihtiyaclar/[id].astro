---
import App from '../../layouts/App.astro';
import NeedDetail from '../../components/app/NeedDetail';
import { Loading } from '../../components/ui/primitives';
import { buildSeed } from '../../lib/seed.ts';

// Static build only (GitHub Pages): seeded ids plus `_`, which the 404 page uses for
// anything created at runtime. The server build renders every id on request.
export function getStaticPaths() {
  const s = buildSeed();
  return [...s.needs.map((n) => n.id), '_'].map((id) => ({ params: { id } }));
}

const { id = '' } = Astro.params;
---

<App title="İhtiyaç" mode="auto" description="İhtiyaç kartı, netlik puanı ve gerekçesiyle sıralanmış adaylar.">
  <NeedDetail client:only="react" id={id}><Loading slot="fallback" /></NeedDetail>
</App>
