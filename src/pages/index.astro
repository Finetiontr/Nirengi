---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/landing/Hero.astro';
import Who from '../components/landing/Who.astro';
import Story from '../components/landing/Story.astro';
import Feature from '../components/landing/Feature.astro';
import Chapter from '../components/landing/Chapter.astro';
import Receipt from '../components/landing/Receipt.astro';
import GencLoop from '../components/landing/GencLoop.astro';
import Stairs from '../components/landing/Stairs.astro';
import Analiz from '../components/landing/Analiz.astro';
import Community from '../components/landing/Community.astro';
import KurumFit from '../components/landing/KurumFit.astro';
import Ledger from '../components/landing/Ledger.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import LiveWeek from '../components/landing/LiveWeek';
import LiveMatch from '../components/landing/LiveMatch';
import type { Line } from '../components/landing/Say';

export const prerender = true;

// What Niri says in each chapter: one source for the inline bubbles and the sticky narrator.
// Genç lines are playful; kurum lines are short and factual.
const say: Record<string, Omit<Line, 'key'>> = {
  fark: {
    mood: 'happy',
    text: 'Duolingo’da XP uygulamada kalır; *burada her XP bir iş makbuzudur.* Her puanın arkasında gösterebileceğin bir iş var.',
  },
  genc: {
    mood: 'cheer',
    text: 'Bu kısım senin için! *Kariyerin ciddi iş*, ama yolu eğlenceli olabilir. Ben de yanındayım.',
  },
  hafta: {
    mood: 'point',
    text: '*Hedefi sen seçersin:* haftada 1, 3 ya da 5 gün. Sayılan commit değil, üretim yaptığın gün. Mola haftası serini bozmaz.',
  },
  dogrulama: {
    mood: 'think',
    text: 'İşin üç basamaktan birinde durur. *Beyan* senin sözün; GitHub hesabın ya da alan adın senin çıkarsa *Doğrulandı*; birlikte çalıştığın kurum imzalarsa *Kurum onaylı*.',
  },
  analiz: {
    mood: 'talk',
    text: 'Her hafta sana kısa bir not yazarım: *neyi iyi yaptın, hangi kanıtın eksik*, sıradaki hangi görev seni ileri taşır.',
  },
  topluluk: {
    mood: 'happy',
    text: 'Takıldığın yeri sor, bildiğini paylaş; *işe yarayan cevabın XP kazandırır*. Açık kaynakta görev alırsan PR’ın birleşince işin doğrulanır.',
  },
  kurum: {
    mood: 'idle',
    text: 'Kurumlara kısa anlatırım: *ihtiyacını yaz, gerekçeli listeyi gör, işi iki onayla kapat.*',
  },
  eslesme: {
    mood: 'point',
    text: 'Her puanın bir *“Neden?”* ekranı var. Adaylar kanıtıyla görünür, *isim ilk temasa kadar gizli*.',
  },
  pilot: {
    mood: 'think',
    text: 'Her aşama *iki taraf da onaylayınca* kapanır. Defterdeki bir kayıt sonradan değişirse zincir bunu hemen gösterir.',
  },
};
const lines: Line[] = Object.entries(say).map(([key, v]) => ({ key, ...v }));
---

<Layout title="nirengi · Yaptığın işle fark edil" description="Gençlerin yaptığı doğrulanmış işi, kurumların yazdığı ihtiyaçlarla buluşturan açık kaynak web hizmeti. Özgeçmiş yok, iş var.">
  <Hero />
  <Who />

  <Story lines={lines}>
    <Feature id="fark" tone="gold" heading="Burada her XP bir *iş makbuzudur*." say={say.fark} more={{ href: '/yontem#ilerleme', label: 'XP nereden geliyor?' }}>
      <Receipt />
    </Feature>

    <Chapter
      id="genc"
      side="genc"
      heading="Genç misin? Bu senin kariyerin, ama *oyun gibi*."
      lead="Haftalık hedef, seri, lig ve görevler. Hepsi gerçek işinle dolar; Niri de her hafta nerede güçlü olduğunu ve nasıl gelişeceğini söyler."
      door={{ href: '/bugun', label: 'Genç olarak başla' }}
    >
      <GencLoop />
    </Chapter>

    <Feature
      id="hafta"
      tone="orange"
      heading="Her gün değil, *her hafta* üret."
      say={say.hafta}
      more={{ href: '/yontem#ilerleme', label: 'İlerleme nasıl sayılıyor?' }}
    >
      <LiveWeek client:only="react"><div slot="fallback" class="h-[300px]"></div></LiveWeek>
    </Feature>

    <Feature
      id="dogrulama"
      tone="cyan"
      reverse
      heading="Söyleneni değil, *doğrulananı* göster."
      say={say.dogrulama}
      more={{ href: '/yontem#merdiven', label: 'Ağırlıklar nasıl işliyor?' }}
    >
      <Stairs />
    </Feature>

    <Feature id="analiz" tone="indigo" heading="Niri haftanı okur, *nasıl gelişeceğini* söyler." say={say.analiz} more={{ href: '/analiz', label: 'Analizine bak' }}>
      <Analiz />
    </Feature>

    <Feature id="topluluk" tone="purple" reverse heading="Yalnız değilsin, birbirinize *destek* olun." say={say.topluluk}>
      <Community />
    </Feature>

    <Chapter
      id="kurum"
      side="kurum"
      heading="Kurum musun? Tek soru: ihtiyacını *ne ölçüde* çözer?"
      lead="İlan değil ihtiyaç yazarsın. Adayları ismiyle değil kanıtıyla görürsün. İş birliğini iki tarafın onayıyla kapatırsın."
      door={{ href: '/kurum', label: 'Kurum olarak ihtiyaç yaz' }}
    >
      <KurumFit />
    </Chapter>

    <Feature
      id="eslesme"
      tone="indigo"
      heading="İhtiyaç yazılır, eşleşme *gerekçesiyle* gelir."
      say={say.eslesme}
      more={{ href: '/yontem#eslesme', label: 'Puan nasıl hesaplanıyor?' }}
    >
      <LiveMatch client:only="react"><div slot="fallback" class="h-[430px]"></div></LiveMatch>
    </Feature>

    <Feature id="pilot" tone="cyan" reverse heading="Deneme projesi *iki onayla* ilerler." say={say.pilot} more={{ href: '/yontem#defter', label: 'Kayıt defteri nasıl çalışıyor?' }}>
      <Ledger />
    </Feature>
  </Story>

  <FinalCta />
</Layout>
