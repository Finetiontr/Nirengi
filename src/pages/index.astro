---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/landing/Hero.astro';
import Who from '../components/landing/Who.astro';
import Story from '../components/landing/Story.astro';
import Feature from '../components/landing/Feature.astro';
import Chapter from '../components/landing/Chapter.astro';
import Receipt from '../components/landing/Receipt.astro';
import GencBoard from '../components/landing/GencBoard.astro';
import KurumFit from '../components/landing/KurumFit.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import type { Line } from '../components/landing/Say';

export const prerender = true;

// What each section's Niri says. Genç lines are playful and Niri climbs the league
// costumes with the story (Who wears Zemin, the receipt Tepe, the genç chapter Sırt,
// with chips for every league; the closing band is Zirve); kurum lines are short,
// factual and plain, with no costume.
const say: Record<string, Omit<Line, 'key'>> = {
  fark: {
    mood: 'happy',
    gear: 1,
    text: 'Başka yerlerde XP uygulamanın içinde kalır; *burada her XP bir iş makbuzudur.* Her puanın arkasında gösterebileceğin bir iş var.',
  },
  genc: {
    mood: 'cheer',
    gear: 2,
    text: 'Bu kısım senin için! *Hedefi sen seçersin:* haftada 1, 3 ya da 5 gün. Sayılan commit değil, üretim yaptığın gün; mola haftası serini bozmaz.',
  },
  kurum: {
    mood: 'idle',
    text: 'Kurumlara kısa anlatırım: *ihtiyacını yaz, gerekçeli listeyi gör, işi iki onayla kapat.*',
  },
};

// The costume teaser: what Niri says in each league's outfit (the key is the tier name).
const tiers: Line[] = [
  { key: 'Zemin', gear: 0, mood: 'happy', text: 'Zemin’de *kurdelemle* başlarım. Her lig yeni bir kıyafet demek.' },
  { key: 'Tepe', gear: 1, mood: 'happy', text: 'Tepe’de *arazi şapkam* gelir. Güneş artık dert değil!' },
  { key: 'Sırt', gear: 2, mood: 'happy', text: 'Sırt’ta *bandana ve harita rulosu*: yolu kendim çizerim.' },
  { key: 'Doruk', gear: 3, mood: 'happy', text: 'Doruk’ta *kask, fener ve jalon* taşırım. Ölçüm ciddileşiyor.' },
  { key: 'Zirve', gear: 4, mood: 'cheer', text: 'Zirve’de *gözlük ve zirve bayrağı*. Bayrağı birlikte dikelim mi?' },
];
---

<Layout title="nirengi · Yaptığın işle fark edil" description="Gençlerin yaptığı doğrulanmış işi, kurumların yazdığı ihtiyaçlarla buluşturan açık kaynak web hizmeti. Özgeçmiş yok, iş var.">
  <Hero />
  <Who />

  <Story>
    <Feature id="fark" tone="gold" heading="Burada her XP bir *iş makbuzudur*." say={say.fark} from={0} more={{ href: '/yontem#ilerleme', label: 'XP nereden geliyor?' }}>
      <Receipt />
    </Feature>

    <Chapter
      id="genc"
      side="genc"
      heading="Genç misin? Bu senin kariyerin, ama *oyun gibi*."
      lead="Haftalık hedef, seri, lig ve görevler. Hepsi gerçek işinle dolar; Niri de her hafta nerede güçlü olduğunu ve nasıl gelişeceğini söyler."
      say={say.genc}
      from={1}
      tiers={tiers}
      door={{ href: '/bugun', label: 'Genç olarak başla' }}
    >
      <GencBoard tiers={tiers} />
    </Chapter>

    <Chapter
      id="kurum"
      side="kurum"
      heading="Kurum musun? Tek soru: ihtiyacını *ne ölçüde* çözer?"
      lead="İlan değil ihtiyaç yazarsın. Adayları ismiyle değil kanıtıyla görürsün. İş birliğini iki tarafın onayıyla kapatırsın."
      say={say.kurum}
      from={null}
      door={{ href: '/kurum', label: 'Kurum olarak ihtiyaç yaz' }}
    >
      <KurumFit />
    </Chapter>
  </Story>

  <FinalCta />
</Layout>
