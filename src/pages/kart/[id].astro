---
import Layout from '../../layouts/Layout.astro';
import PublicCard from '../../components/app/PublicCard';
import { Loading } from '../../components/ui/primitives';
import { buildSeed } from '../../lib/seed.ts';

// Static build only (GitHub Pages): seeded ids plus `_`, which the 404 page uses for
// anything created at runtime. The server build renders every id on request.
export function getStaticPaths() {
  const s = buildSeed();
  return [...s.pilots.map((p) => p.id), '_'].map((id) => ({ params: { id } }));
}

const { id = '' } = Astro.params;
---

<Layout title="Proje özet kartı" description="Tarafların onayıyla yayımlanan proje sonucu: süre, karşılanan kriterler ve doğrulanabilir kayıt defteri özeti.">
  <PublicCard client:only="react" id={id}><Loading slot="fallback" /></PublicCard>
</Layout>
