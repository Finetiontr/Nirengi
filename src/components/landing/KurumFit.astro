---
// The kurum chapter's answer to "ne ölçüde çözer?": the three things you get, in the
// order you meet them, and the three sourced numbers behind the problem. Every number
// carries its source; nothing here is invented.
import { Tri } from '../ui/pafta';

const steps = [
  { n: 1, title: 'İhtiyaç kartı', text: 'Sorununu yedi alanlı karta yazarsın. Netlik puanı 70’i geçince yayına çıkar.' },
  { n: 2, title: 'Gerekçeli kısa liste', text: 'Her adayın puanı dört parçadan çıkar ve “Neden?” ile açılır. İsim ilk temasa kadar gizli.' },
  { n: 3, title: 'Deneme projesi', text: 'Aşamalar iki tarafın onayıyla kapanır; her kayıt değiştirilemez deftere yazılır.' },
];

const facts = [
  { v: '%71,0', text: 'bilişim uzmanı almakta zorlanan girişimlerin “ilgili iş deneyimi yok” diyen payı', src: 'TÜİK, Girişimlerde BİT Kullanım Araştırması 2025' },
  { v: '%10,8', text: '10–49 çalışanlı girişimlerde bilişim uzmanı çalıştıranların payı', src: 'TÜİK, Girişimlerde BİT Kullanım Araştırması 2026' },
  { v: '700’de 1', text: 'diploma şartını kaldıran şirketlerde gerçekten değişen işe alım', src: 'Harvard Business School ve Burning Glass Institute, 2024' },
];
---

<div>
  <ol class="grid gap-4 md:grid-cols-3">
    {
      steps.map((s) => (
        <li class="rounded-[18px] border-2 border-line bg-bg p-4 sm:p-5">
          <span class="block w-fit" aria-hidden="true">
            <Tri size={34} tone="indigo" state="done">
              <span class="text-[13px] font-black leading-none text-white">{s.n}</span>
            </Tri>
          </span>
          <p class="mt-3 text-[17px] font-black text-ink">{s.title}</p>
          <p class="mt-1 text-[15px] font-semibold leading-snug text-ink-3">{s.text}</p>
        </li>
      ))
    }
  </ol>

  <div class="mt-10">
    <p class="h-sec">Çözdüğü sorun, sayılarla</p>
    <dl class="mt-4 grid gap-x-6 gap-y-5 md:grid-cols-3">
      {
        facts.map((f) => (
          <div class="border-l-[3px] border-indigo/40 pl-4">
            <dt class="num text-[clamp(30px,3.4vw,38px)] font-black leading-none tracking-[-0.02em] text-indigo">{f.v}</dt>
            <dd class="mt-2 text-[15px] font-semibold leading-snug text-ink-2">{f.text}</dd>
            <dd class="mt-1.5 text-[12.5px] font-semibold text-ink-3">Kaynak: {f.src}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>
