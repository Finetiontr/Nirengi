---
// The landing's body: the story sections. Sections are full bleed (their bands and
// contours run edge to edge); their content sits in one centred frame shared with the
// nav, hero and closing band. Each section has its own Niri in its own layout (Say),
// on phones and wide screens alike.
---

<div class="story">
  <slot />
</div>

<style is:global>
  /* The landing's one frame: nav, hero, story, closing (and footer) share this width, so
     their left edges line up. Other pages keep the 1120px default. */
  :root {
    --frame: 1120px;
  }
  @media (min-width: 1280px) {
    :root {
      --frame: 1280px;
    }
  }
  @media (min-width: 1600px) {
    :root {
      --frame: 1360px;
    }
  }
  /* Niri's bubble waits while Niri enters or turns, then grows in with its line (Say). */
  .js .say-bubble[data-hide] {
    animation: say-out 160ms ease-in both;
  }
  @keyframes say-out {
    to { opacity: 0; transform: scale(0.94); visibility: hidden; }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .say-bubble[data-hide] { animation: none; opacity: 0; }
  }
</style>
