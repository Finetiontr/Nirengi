---
// The genç loop in four stops: what you do, and what it turns into. Each stop is a
// concept icon in its own colour on a short dashed trail, read left to right.
import { Bolt, Flame, Route, Shield } from '../ui/icons';

const stops = [
  { icon: 'route', title: 'Bir iş yap', text: 'Görev, açık kaynak PR’ı ya da toplulukta işe yarayan bir cevap.' },
  { icon: 'gem', title: 'Kanıtla', text: 'Doğrulanınca XP’si makbuzuyla gelir.' },
  { icon: 'beacon', title: 'Seriyi yak', text: 'Haftada 1, 3 ya da 5 gün: hedefini sen seçersin.' },
  { icon: 'ridge', title: 'Ligde tırman', text: 'Zemin’den Zirve’ye, her hafta yeniden.' },
] as const;
---

<ol class="grid grid-cols-2 gap-x-4 gap-y-6 md:grid-cols-4">
  {
    stops.map((s, i) => (
      <li class="relative">
        {i < stops.length - 1 && (
          <span class="absolute left-[56px] right-2 top-[24px] hidden border-t-[3px] border-dotted border-orange/50 md:block" aria-hidden="true" />
        )}
        <span class="relative grid h-[48px] w-[48px] place-items-center rounded-[14px] border-2 border-line bg-bg">
          {s.icon === 'route' && <Route size={34} />}
          {s.icon === 'gem' && <Bolt size={34} />}
          {s.icon === 'beacon' && <Flame size={34} className="flame-live" />}
          {s.icon === 'ridge' && <Shield size={34} tier={3} />}
        </span>
        <p class="mt-2.5 text-[17px] font-black text-ink">{s.title}</p>
        <p class="mt-0.5 text-[15px] font-semibold leading-snug text-ink-3">{s.text}</p>
      </li>
    ))
  }
</ol>
