---
// The difference in one picture: an XP gem drops into a receipt. The receipt prints,
// its rows fill in and a "Doğrulandı" stamp lands, so "every XP is a work receipt" is
// something you watch happen. Motion starts when the sheet reveals; at rest it is printed.
import { Bolt } from '../ui/icons';
import { LevelBadge } from '../ui/primitives';

const rows = [
  { k: 'İş', v: 'Açık kaynak kütüphanede tarih biçimi hatası düzeltildi' },
  { k: 'Kanıt', v: 'Açık kaynak · PR birleşti' },
] as const;
---

<div class="relative">
  <div class="flex items-center gap-3">
    <span class="rc-chip pill shrink-0 whitespace-nowrap bg-gold-tint !px-3 !py-1.5 text-[15px] !font-extrabold text-gold-ink">
      <Bolt size={24} /> +40 XP
    </span>
    <span class="text-[14px] font-bold text-ink-3">Nereden geldi? Makbuzu burada.</span>
  </div>

  <div class="relative ml-[22px] h-7 border-l-[3px] border-dotted border-gold-lip/60" aria-hidden="true">
    <span class="rc-drop absolute -left-[13px] top-0"><Bolt size={22} /></span>
  </div>

  <div class="rc-paper relative rounded-[16px] border-2 border-line bg-bg-2 px-4 pb-4 pt-3 sm:px-5">
    <div class="flex items-baseline gap-2 border-b-2 border-dashed border-line-2 pb-2.5 pr-28">
      <p class="text-[18px] font-black text-ink">İş makbuzu</p>
      <p class="mono hidden text-[13px] text-ink-3 sm:block">no. 0128</p>
    </div>
    <dl class="mt-3 space-y-2.5">
      {
        rows.map((r, i) => (
          <div class="rc-row grid grid-cols-[64px_1fr] gap-2" style={`--d:${0.75 + i * 0.15}s`}>
            <dt class="text-[14px] font-bold text-ink-3">{r.k}</dt>
            <dd class="text-[15px] font-bold leading-snug text-ink-2">{r.v}</dd>
          </div>
        ))
      }
      <div class="rc-row grid grid-cols-[64px_1fr] items-center gap-2" style="--d:1.05s">
        <dt class="text-[14px] font-bold text-ink-3">Seviye</dt>
        <dd><LevelBadge level="S2" /></dd>
      </div>
      <div class="rc-row grid grid-cols-[64px_1fr] gap-2" style="--d:1.2s">
        <dt class="text-[14px] font-bold text-ink-3">Kayıt</dt>
        <dd class="mono truncate text-[13px] text-ink-2">3f9a·c21e·77d0·b41a</dd>
      </div>
    </dl>
    <div class="mt-3 flex items-center justify-between gap-3 border-t-2 border-dashed border-line-2 pt-2.5">
      <span class="text-[14px] font-bold text-ink-3">Kazanılan</span>
      <span class="rc-gem flex items-center gap-1 text-[16px] font-black text-gold-ink"><Bolt size={22} /> 40 XP</span>
    </div>

    <span
      class="rc-stamp absolute right-3 top-2 rounded-[10px] border-[3px] border-cyan-lip px-2.5 py-0.5 text-[17px] font-black text-cyan-lip"
      style="transform:rotate(-8deg);background:rgb(var(--bg-2))"
      aria-hidden="true">Doğrulandı</span
    >
  </div>
  <p class="mt-3 text-[13px] font-semibold text-ink-3">Örnek makbuz, kurgusal. Gerçek makbuzda bağlantı kanıtın kendisine gider.</p>
</div>

<style is:global>
  /* The drop and the print run only once the sheet has revealed (data-in on the Feature column). */
  [data-in] .rc-chip { animation: pop 420ms var(--ease-out) 0.15s both; }
  [data-in] .rc-drop { animation: rc-drop 0.7s cubic-bezier(0.55, 0, 0.9, 0.6) 0.35s both; }
  [data-in] .rc-paper { animation: rc-print 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both; }
  [data-in] .rc-row { animation: rise 380ms var(--ease-out) var(--d) both; }
  [data-in] .rc-gem { animation: pop 420ms var(--ease-out) 1.35s both; }
  [data-in] .rc-stamp { animation: rc-stamp 420ms var(--ease-out) 1.6s both; }
  .rc-drop { opacity: 0; }
  @keyframes rc-drop {
    0% { transform: translateY(-6px) scale(0.6); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: translateY(34px) scale(1); opacity: 0; }
  }
  @keyframes rc-print {
    from { clip-path: inset(0 0 100% 0 round 16px); }
    to { clip-path: inset(0 0 0 0 round 16px); }
  }
  @keyframes rc-stamp {
    from { transform: scale(1.6) rotate(-16deg); opacity: 0; }
    to { transform: scale(1) rotate(-8deg); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-in] .rc-chip,
    [data-in] .rc-drop,
    [data-in] .rc-paper,
    [data-in] .rc-row,
    [data-in] .rc-gem,
    [data-in] .rc-stamp {
      animation: none;
    }
  }
</style>
