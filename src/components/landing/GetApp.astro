---
// The landing's foot, after the closing band: nirengi on the phone. Phones get the install key
// (the browser's own prompt or its steps), computers the QR code that opens /uygulama on the
// phone. Beside it the real Bugün screen on a phone that stands on the section's foot and is
// cut by it, as if rising out of the page. The installed app never shows it.
import InstallKey, { QrInstall } from '../shell/Install';
---

<section class="only-browser relative overflow-hidden border-t-2 border-line" aria-labelledby="app-title">
  <div class="relative mx-auto grid max-w-[var(--frame,1120px)] gap-10 px-4 pt-14 sm:px-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-16 lg:pt-16">
    <div class="self-center lg:pb-16">
      <h2 id="app-title" class="text-[clamp(28px,3.6vw,40px)] font-black leading-[1.12] tracking-[-0.02em] text-ink">Nirengi telefonunda da çalışır.</h2>
      <p class="mt-3 max-w-[46ch] text-[17px] font-medium leading-relaxed text-ink-2">
        Ana ekranına ekle: genç işini cebinden ekler, kurum aşamayı cebinden onaylar. Mağaza ve kayıt gerekmez; internet olmasa da açılır.
      </p>
      <div class="mt-7 max-w-[400px] lg:hidden"><InstallKey client:load /></div>
      <div class="mt-8 hidden lg:block"><QrInstall client:load /></div>
    </div>

    <div class="relative mx-auto h-[300px] w-[248px] sm:h-[340px] lg:h-[420px] lg:w-[280px]" aria-hidden="true">
      <div class="absolute inset-x-0 top-0 rounded-[38px] bg-[#16142a] p-[8px] ring-2 ring-line">
        <img src="/sunum/genc-bugun.webp" alt="" width="780" height="1688" loading="lazy" decoding="async" class="block h-auto w-full rounded-[31px]" />
      </div>
    </div>
  </div>
</section>
